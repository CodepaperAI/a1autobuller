# Cloudflare Turnstile (required for contact and booking forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (required for contact and booking emails)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
BOOKING_TO_EMAIL=

# Uplift AI (optional; enables remote blog posts)
UPLIFTAI_API_TOKEN=
